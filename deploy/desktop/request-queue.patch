+    if remote_tool not in _UI_STATUS_TOOLS:
+        raise ValueError("Only terminal and job status can use the UI status cache")
+    principal = _request_principal(request)
+    key = (
+        machine,
+        remote_tool,
+        json.dumps(remote_args, sort_keys=True, separators=(",", ":")),
+        principal.subject,
