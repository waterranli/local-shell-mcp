+async def _ui_status_snapshot(
+    request: Request,
+    machine: str,
+    local_call: Callable[[], Any | Awaitable[Any]],
+    remote_tool: str,
+    remote_args: dict[str, Any],
+) -> Any:
+    """Coalesce UI status polls only; terminal attachment and tools stay fresh."""
