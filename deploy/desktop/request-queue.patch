+def _ui_status_entries() -> OrderedDict[tuple[Any, ...], _UIStatusEntry]:
+    loop = asyncio.get_running_loop()
+    with _UI_STATUS_CACHES_LOCK:
+        return _UI_STATUS_CACHES.setdefault(loop, OrderedDict())
